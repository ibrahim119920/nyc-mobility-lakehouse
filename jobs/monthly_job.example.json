{
  "name": "nyc_mobility_monthly",
  "timeout_seconds": 0,
  "max_concurrent_runs": 1,
  "tasks": [
    {
      "task_key": "prepare",
      "run_if": "ALL_SUCCESS",
      "notebook_task": {
        "notebook_path": "/Workspace/Users/<email>/nyc-mobility-lakehouse/notebooks/00_prepare_batch",
        "source": "WORKSPACE"
      },
      "max_retries": 0,
      "timeout_seconds": 0
    },
    {
      "task_key": "bronze",
      "depends_on": [{ "task_key": "prepare" }],
      "run_if": "ALL_SUCCESS",
      "notebook_task": {
        "notebook_path": "/Workspace/Users/<email>/nyc-mobility-lakehouse/notebooks/01_bronze",
        "source": "WORKSPACE"
      },
      "max_retries": 0,
      "timeout_seconds": 0
    },
    {
      "task_key": "silver",
      "depends_on": [{ "task_key": "bronze" }],
      "run_if": "ALL_SUCCESS",
      "notebook_task": {
        "notebook_path": "/Workspace/Users/<email>/nyc-mobility-lakehouse/notebooks/02_silver",
        "source": "WORKSPACE"
      },
      "max_retries": 0,
      "timeout_seconds": 0
    },
    {
      "task_key": "gold",
      "depends_on": [{ "task_key": "silver" }],
      "run_if": "ALL_SUCCESS",
      "notebook_task": {
        "notebook_path": "/Workspace/Users/<email>/nyc-mobility-lakehouse/notebooks/03_gold",
        "source": "WORKSPACE"
      },
      "max_retries": 0,
      "timeout_seconds": 0
    }
  ],
  "queue": { "enabled": true },
  "parameters": [
    { "name": "config_path", "default": "/Workspace/Users/<email>/nyc-mobility-lakehouse/config/batch.local.json" },
    { "name": "source_month", "default": "" }
  ],
  "performance_target": "PERFORMANCE_OPTIMIZED"
}
